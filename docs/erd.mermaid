erDiagram
    TAIKHOAN {
        varchar(50) Username PK "Tên đăng nhập"
        varchar(255) Password "Mật khẩu (Bcrypt/MD5)"
        varchar(100) FullName "Họ và tên nhân viên"
        varchar(20) Role "Admin | User"
    }

    THAMSO {
        int SoLuongNhapItNhat "Mặc định: 150 (QĐ1)"
        int SoLuongTonToiDaTruocNhap "Mặc định: 300 (QĐ1)"
        decimal SoTienNoToiDa "Mặc định: 20000.00 (QĐ2)"
        int SoLuongTonSauToiThieu "Mặc định: 20 (QĐ2)"
        float DonGiaBanYeuCau "Mặc định: 1.05 (QĐ2)"
        tinyint QuyDinh "Mặc định: 1 - Áp dụng QĐ3"
    }

    SACH {
        varchar(20) MaSach PK "Mã đầu sách (VD: S001)"
        varchar(255) TenSach "Tên sách (Indexed)"
        varchar(100) TheLoai "Thể loại"
        varchar(100) TacGia "Tác giả"
        int SoLuongTon "Số lượng tồn hiện tại"
        decimal DonGia "Đơn giá nhập gần nhất"
    }

    KHACHHANG {
        varchar(20) MaKhachHang PK "Mã khách hàng (VD: KH001)"
        varchar(100) HoTenKhachHang "Họ tên khách hàng (Indexed)"
        varchar(255) DiaChi "Địa chỉ liên hệ"
        varchar(20) DienThoai "Số điện thoại"
        varchar(100) Email "Địa chỉ Email"
        decimal SoTienNo "Tổng dư nợ hiện tại"
    }

    PHIEUNHAP {
        int MaPhieuNhap PK "Auto Increment"
        datetime NgayNhap "Ngày giờ lập phiếu (Indexed)"
    }

    CHITIETPHIEUNHAP {
        int MaPhieuNhap PK, FK "Tham chiếu PHIEUNHAP"
        varchar(20) MaSach PK, FK "Tham chiếu SACH"
        int SoLuongNhap "Số lượng sách nhập"
        decimal DonGiaNhap "Đơn giá nhập tại thời điểm lập"
    }

    PHIEUHOADON {
        int MaPhieuHoaDon PK "Auto Increment"
        datetime NgayLapHoaDon "Ngày giờ lập hóa đơn (Indexed)"
        varchar(20) MaKhachHang FK "Tham chiếu KHACHHANG"
    }

    CHITIETPHIEUHOADON {
        int MaPhieuHoaDon PK, FK "Tham chiếu PHIEUHOADON"
        varchar(20) MaSach PK, FK "Tham chiếu SACH"
        int SoLuongBan "Số lượng sách bán"
        decimal DonGiaBan "Đơn giá bán lịch sử tại thời điểm lập"
    }

    PHIEUTHUTIEN {
        int MaPhieuThu PK "Auto Increment"
        varchar(20) MaKhachHang FK "Tham chiếu KHACHHANG"
        datetime NgayThuTien "Ngày giờ thu tiền (Indexed)"
        decimal SoTienThu "Số tiền khách thanh toán"
    }

    PHIEUNHAP ||--|{ CHITIETPHIEUNHAP : "bao_gom"
    SACH ||--o{ CHITIETPHIEUNHAP : "duoc_nhap"
    KHACHHANG ||--o{ PHIEUHOADON : "mua_hang"
    PHIEUHOADON ||--|{ CHITIETPHIEUHOADON : "co_chi_tiet"
    SACH ||--o{ CHITIETPHIEUHOADON : "duoc_ban"
    KHACHHANG ||--o{ PHIEUTHUTIEN : "thanh_toan_no"

